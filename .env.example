# Public TURN host for remote clients (domain or public IP)
TURN_URLS=turn:your-domain-or-ip:3478?transport=udp,turn:your-domain-or-ip:3478?transport=tcp


# TURN auth (static long-term credentials)
TURN_USERNAME=coincoin
TURN_CREDENTIAL=change-me

# TURN realm and public external IP (use PUBLIC/PRIVATE if behind NAT)
TURN_REALM=your-domain-or-ip
TURN_EXTERNAL_IP=your-public-ip

# Force relayed media through TURN (recommended for different networks)
ICE_TRANSPORT_POLICY=relay
